PORT=3000
DATA_DIR=./data
JWT_SECRET=dev-only-insecure-secret
TOKEN_TTL=30d
TLS_CERT_PATH=
TLS_KEY_PATH=
# 只有部署在 Nginx/Caddy/Traefik 等反向代理之后时才设为 1；直接暴露公网时不要开，
# 否则限流可以被伪造的 X-Forwarded-For 头绕过。
TRUST_PROXY=0

# 若在纯私有内网/NAS 环境下运行，并需要让 MCP upload_attachment 支持从内网其他服务 (如 192.168.x.x, 10.x.x.x) 拉取图片/附件，可设为 1
ALLOW_PRIVATE_ATTACHMENT_URLS=0

# Database Configuration (supports sqlite | postgres | mysql | json)
DB_TYPE=sqlite
# SQLite config
SQLITE_PATH=./data/nimbus.sqlite

# PostgreSQL config (alternative)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/nimbus
# PG_HOST=localhost
# PG_PORT=5432
# PG_USER=postgres
# PG_PASSWORD=
# PG_DATABASE=nimbus

# MySQL config (alternative)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=nimbus
