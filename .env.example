# FNS server config
PORT=8787
# Secret used to sign JWT auth tokens - CHANGE THIS in production
JWT_SECRET=change-this-to-a-long-random-string
# Where vault files & metadata are stored
DATA_DIR=./data
# Token lifetime
TOKEN_TTL=30d

# Optional: enable HTTPS/WSS directly in the Node process by pointing these
# at a cert/key pair (e.g. from Let's Encrypt). Leave both empty to serve
# plain HTTP/WS instead (fine if you're terminating TLS at a reverse proxy).
TLS_CERT_PATH=
TLS_KEY_PATH=
