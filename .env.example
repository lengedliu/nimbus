PORT=3000
DATA_DIR=./data
JWT_SECRET=dev-only-insecure-secret
TOKEN_TTL=30d
TLS_CERT_PATH=
TLS_KEY_PATH=
# 部署在反向代理（Nginx/Caddy/Cloud Run/Docker 网关）之后设为 1（默认开启）；
# 若完全裸露在公网且前置没有任何反代网关时，可设为 0。
TRUST_PROXY=1

# 跨域白名单（多个域名用逗号分隔）。留空则允许任意来源访问。
# 若将 Web 管理面板部署在固定域名下，建议配置以收紧跨域权限，例如：
# CORS_ALLOWED_ORIGINS=https://notes.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=

# Database Configuration (supports sqlite | postgres | mysql | json)
DB_TYPE=sqlite
# SQLite config
SQLITE_PATH=./data/nimbus.sqlite

# PostgreSQL config (alternative)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/nimbus
# PG_HOST=localhost
# PG_PORT=5432
# PG_USER=postgres
# PG_PASSWORD=
# PG_DATABASE=nimbus

# MySQL config (alternative)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=nimbus
